<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全屏沉浸式主题，适配圆屏手表 -->

    <!-- MD3 浅色启动画面主题（冷启动直接与 Compose 浅色表面无缝贴合） -->
    <style name="Theme.WatchReader.Splash" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/md_light_background</item>
        <item name="android:colorBackground">@color/md_light_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- MD3 浅色主主题 -->
    <style name="Theme.WatchReader" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/md_light_background</item>
        <item name="android:colorBackground">@color/md_light_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
