<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全屏沉浸式主题，适配圆屏手表 -->

    <!-- 亮色羊皮纸启动画面主题（冷启动直接与 Compose 浅色羊皮纸白无缝贴合） -->
    <style name="Theme.WatchReader.Splash" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#FFF7F4EB</item>
        <item name="android:colorBackground">#FFF7F4EB</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 亮色羊皮纸主主题 -->
    <style name="Theme.WatchReader" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#FFF7F4EB</item>
        <item name="android:colorBackground">#FFF7F4EB</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 深色 AMOLED 纯黑主主题（夜间护眼 + OLED 0 耗电） -->
    <style name="Theme.WatchReader.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
